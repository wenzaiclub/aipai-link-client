# 复制成 keystore.properties 再改。
# 这个文件和证书要一起备份：丢了就没法给已安装的用户升级（只能让用户卸载重装）。
# keystore.properties 已经被 .gitignore 挡掉，不会进仓库。

storeFile=keystore/aipai.jks
storePassword=改成你的证书口令
keyAlias=aipai
keyPassword=改成你的证书口令

# 生成自己的证书（一次就够，之后一直用它签同一个包名）：
#   keytool -genkeypair -v -keystore keystore/aipai.jks -alias aipai \
#     -keyalg RSA -keysize 2048 -validity 10000
