<Window x:Class="AiPai.Compact.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="艾派互联" Width="380" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33455F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo-mark.png" Width="18" Height="18" />
                    <TextBlock Text="艾派互联" Style="{StaticResource TxtTitle}" Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnMin" Style="{StaticResource BtnIcon}" Content="—"
                            Click="Min_Click" ToolTip="最小化" />
                    <Button x:Name="BtnClose" Style="{StaticResource BtnIcon}" Content="✕"
                            Click="Close_Click" ToolTip="退出" />
                </StackPanel>
            </Grid>

            <!-- 页面区 -->
            <ContentControl x:Name="PageHost" Grid.Row="1" />

            <!-- 底部导航（登录后显示） -->
            <Grid x:Name="BottomNav" Grid.Row="2" Background="{StaticResource PanelBg2}"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Tag="home" Click="Nav_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Path x:Name="NavHomeIcon" Data="M3,10.5 L12,3.5 L21,10.5 V20 H14 V14 H10 V20 H3 Z"
                              Width="17" Height="17" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NavHomeText" Text="首页" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" />
                        <Border x:Name="NavHomeLine" Height="2" Width="22" CornerRadius="1" Margin="0,2,0,0"
                                Background="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Tag="tools" Click="Nav_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Path x:Name="NavToolsIcon" Data="M4,7 H20 M4,12 H20 M4,17 H14"
                              Width="17" Height="17" Style="{StaticResource IconStroke}"
                              HorizontalAlignment="Center" />
                        <TextBlock x:Name="NavToolsText" Text="工具" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecond}" Margin="0,3,0,0" />
                        <Border x:Name="NavToolsLine" Height="2" Width="22" CornerRadius="1" Margin="0,2,0,0"
                                Background="Transparent" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Tag="menu" Click="Nav_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Path x:Name="NavMenuIcon" Data="M12,4 A4,4 0 1 0 12,12 A4,4 0 1 0 12,4 M4,21 C4,16.5 7.5,14 12,14 C16.5,14 20,16.5 20,21"
                              Width="17" Height="17" Style="{StaticResource IconStroke}"
                              HorizontalAlignment="Center" />
                        <TextBlock x:Name="NavMenuText" Text="我的" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecond}" Margin="0,3,0,0" />
                        <Border x:Name="NavMenuLine" Height="2" Width="22" CornerRadius="1" Margin="0,2,0,0"
                                Background="Transparent" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
