<Window x:Class="AiPai.Compact.Views.ClosePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭艾派互联" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33506F" BorderThickness="1">
        <StackPanel Margin="16,12,16,14">
            <Grid MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="关闭艾派互联" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnIcon}" Content="✕" HorizontalAlignment="Right"
                        Click="Cancel_Click" />
            </Grid>

            <TextBlock x:Name="TxtMsg" Text="" FontSize="12.5" TextWrapping="Wrap"
                       Margin="0,12,0,0" Foreground="{StaticResource TextSecond}" />

            <Border Background="{StaticResource CardBg}" CornerRadius="9" Padding="11,9" Margin="0,10,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="最小化到托盘：后台继续跑，组网不断，双击托盘图标就能打开面板"
                               FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
                    <TextBlock Text="退出程序：断开组网并完全退出" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,4,0,0" Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Button Content="取消" Height="34" Width="72" HorizontalAlignment="Left"
                        Style="{StaticResource BtnGhost}" Click="Cancel_Click" />
                <Button x:Name="BtnExit" Content="退出程序" Height="34" Width="92"
                        HorizontalAlignment="Right" Style="{StaticResource BtnGhost}"
                        Click="Exit_Click" />
                <Button x:Name="BtnMin" Content="最小化到托盘" Height="34" Width="120"
                        HorizontalAlignment="Right" Margin="0,0,98,0"
                        Style="{StaticResource BtnPrimary}" Click="Minimize_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
