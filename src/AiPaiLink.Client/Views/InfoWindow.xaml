<Window x:Class="AiPai.Compact.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="336" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33455F" BorderThickness="1">
        <StackPanel Margin="16,12,16,14">
            <Grid MouseLeftButtonDown="Title_MouseDown">
                <TextBlock x:Name="TxtTitle" Text="提示" Style="{StaticResource TxtTitle}"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnIcon}" Content="✕" HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>
            <TextBlock x:Name="TxtBody" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{StaticResource TextSecond}" LineHeight="19" />
            <Button Content="知道了" Style="{StaticResource BtnPrimary}" Margin="0,14,0,0"
                    Click="Close_Click" />
        </StackPanel>
    </Border>
</Window>
