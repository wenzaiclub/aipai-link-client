<Window x:Class="AiPai.Compact.Views.DeleteNetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除组网" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF5A3A3A" BorderThickness="1">
        <StackPanel Margin="16,12,16,14">
            <Grid MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="删除组网" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnIcon}" Content="✕" HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>

            <TextBlock x:Name="TxtNet" Text="" FontSize="12.5" Margin="0,12,0,0"
                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />

            <Border Background="{StaticResource CardBg}" CornerRadius="9" Padding="11,9" Margin="0,10,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="删除后：" FontSize="11.5" Foreground="{StaticResource TextSecond}" />
                    <TextBlock Text="· 组网内所有设备立即断开" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextDim}" />
                    <TextBlock Text="· 该组网占用的固定 IP 会被释放" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextDim}" />
                    <TextBlock Text="· 组网从所有成员的列表里消失，且不可恢复" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Button x:Name="BtnSend" Content="发送验证码" Height="28" Padding="10,0" FontSize="11.5"
                        HorizontalAlignment="Left" Style="{StaticResource BtnGhost}" Click="Send_Click" />
                <TextBlock x:Name="TxtCodeInfo" Text="点左侧获取临时验证码" FontSize="10.5"
                           VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="210"
                           TextWrapping="Wrap" TextAlignment="Right"
                           Foreground="{StaticResource TextDim}" />
            </Grid>

            <TextBlock Text="验证码" FontSize="11.5" Margin="2,12,0,5"
                       Foreground="{StaticResource TextSecond}" />
            <TextBox x:Name="TxtCode" Style="{StaticResource Input}" FontFamily="Consolas"
                     MaxLength="6" />

            <TextBlock x:Name="TxtMsg" Text="" FontSize="11" TextWrapping="Wrap" Margin="2,9,0,0" />

            <Grid Margin="0,14,0,0">
                <Button Content="取消" Height="36" Width="96" HorizontalAlignment="Left"
                        Style="{StaticResource BtnGhost}" Click="Close_Click" />
                <Button x:Name="BtnDelete" Content="确认删除" Height="36" Width="120"
                        HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}"
                        Background="{StaticResource DangerBrush}" Click="Delete_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
