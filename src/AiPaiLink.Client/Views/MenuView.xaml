<UserControl x:Class="AiPai.Compact.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,6,14,10">

            <!-- 账号卡 -->
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="14,12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtUser" Text="未登录" Style="{StaticResource TxtTitle}" />
                        <Border Background="#222F6BFF" CornerRadius="8" Padding="8,2" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPlan" Text="免费版" FontSize="10.5"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtDevices" Text="" Style="{StaticResource TxtSub}" Margin="0,6,0,0" />
                    <Grid Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设备号" Style="{StaticResource TxtSub}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtDeviceId" Text="------" Style="{StaticResource TxtBody}"
                                       FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="复制" HorizontalAlignment="Right" Height="24" Padding="10,0"
                                FontSize="11" Style="{StaticResource BtnGhost}" Click="CopyId_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 设置项 -->
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Margin="0,12,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Height="46" Margin="14,0">
                        <TextBlock Text="开机启动" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="SwAutoStart" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="AutoStart_Click" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="54" Margin="14,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="最小化到托盘" Style="{StaticResource TxtBody}" />
                            <TextBlock Text="点最小化按钮时缩到托盘，不占任务栏" FontSize="10"
                                       Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="SwTray" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="Tray_Click" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="54" Margin="14,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="退出前询问" Style="{StaticResource TxtBody}" />
                            <TextBlock Text="关面板时问一句：缩到托盘还是退出" FontSize="10"
                                       Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="SwClosePrompt" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="ClosePrompt_Click" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="46" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="Alias_Click">
                        <TextBlock Text="别名访问" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <TextBlock Text="›" FontSize="16" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="70" Margin="14,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="局域网广播中继" Style="{StaticResource TxtBody}" />
                            <TextBlock Text="开：局域网游戏房、网上邻居、打印机发现能互相看见"
                                       FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                            <TextBlock Text="关：只保证单播互通（共享文件、远程桌面照用）"
                                       FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,1,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="SwRelay" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="Relay_Click" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="46" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="Update_Click">
                        <TextBlock Text="检查更新" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <TextBlock Text="›" FontSize="16" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="46" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="Console_Click">
                        <TextBlock Text="进入控制台" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <TextBlock Text="›" FontSize="16" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="46" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="Logs_Click">
                        <TextBlock Text="查看日志" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <TextBlock Text="›" FontSize="16" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="46" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="About_Click">
                        <TextBlock Text="关于艾派互联" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <TextBlock Text="›" FontSize="16" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,0" />

                    <Grid Height="46" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="Licenses_Click">
                        <TextBlock Text="开源许可 / 第三方组件" Style="{StaticResource TxtBody}" VerticalAlignment="Center" />
                        <TextBlock Text="›" FontSize="16" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="退出登录" Style="{StaticResource BtnGhost}" Margin="0,14,0,0"
                    Click="Logout_Click" />
            <TextBlock Text="正式版 v1.0.10" Style="{StaticResource TxtSub}" HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
