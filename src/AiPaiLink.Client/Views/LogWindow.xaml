<Window x:Class="AiPai.Compact.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志" Width="760" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="True"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33455F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource PanelBg2}" MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="日志" Style="{StaticResource TxtTitle}" Margin="14,0,0,0"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button Style="{StaticResource BtnIcon}" Content="⟳" Click="Refresh_Click" ToolTip="刷新" />
                    <Button Style="{StaticResource BtnIcon}" Content="📂" Click="OpenDir_Click" ToolTip="打开日志目录" />
                    <Button Style="{StaticResource BtnIcon}" Content="✕" Click="Close_Click" ToolTip="关闭 (Esc)" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,6">
                <Button x:Name="NavClient" Tag="client" Click="Tab_Click" Height="26" Padding="10,0"
                        FontSize="11.5" Style="{StaticResource BtnGhost}" Content="客户端日志" Margin="0,0,6,0" />
                <Button x:Name="NavEngine" Tag="engine" Click="Tab_Click" Height="26" Padding="10,0"
                        FontSize="11.5" Style="{StaticResource BtnGhost}" Content="引擎日志" />
                <TextBlock x:Name="TxtFile" Text="" FontSize="10.5" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource PanelBg2}" CornerRadius="9" Margin="14,0,14,12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="10">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextSecond}" FontFamily="Consolas"
                             FontSize="11.5" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
