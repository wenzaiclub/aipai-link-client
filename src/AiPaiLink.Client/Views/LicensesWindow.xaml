<Window x:Class="AiPai.Compact.Views.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开源许可" Width="420" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33455F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="开源许可 / 第三方组件" Style="{StaticResource TxtTitle}"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnIcon}" Content="✕" HorizontalAlignment="Right"
                        Margin="0,0,6,0" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,0,14,0">
                <StackPanel x:Name="List" />
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="14,10,14,14" FontSize="10.5" TextWrapping="Wrap"
                       LineHeight="17" Foreground="{StaticResource TextDim}"
                       Text="本软件以「独立进程 / 动态库」方式调用下列组件，未修改其源码；许可证全文随安装目录 engine\LICENSE 提供，用户可自行替换这些组件文件。" />
        </Grid>
    </Border>
</Window>
