<UserControl x:Class="AiPai.Compact.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,8,14,10">
            <TextBlock Text="工具" Style="{StaticResource TxtTitle}" Margin="2,0,0,4" />
            <TextBlock Text="连接后可直接访问组网内其他设备的共享资源" Style="{StaticResource TxtSub}"
                       Margin="2,0,0,12" TextWrapping="Wrap" />
            <ItemsControl x:Name="Wall">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 3 列铺满：图标左右都贴到内容区两边，不留空档 -->
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
