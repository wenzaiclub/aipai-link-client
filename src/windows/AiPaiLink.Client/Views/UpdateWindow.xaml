<Window x:Class="AiPai.Compact.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33506F" BorderThickness="1">
        <StackPanel Margin="16,12,16,14">
            <Grid MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="软件更新" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnIcon}" Content="✕" HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>

            <TextBlock x:Name="TxtVersion" Text="" FontSize="12.5" Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecond}" />

            <Border Background="{StaticResource CardBg}" CornerRadius="9" Padding="11,9" Margin="0,10,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <TextBlock x:Name="TxtStatus" Text="正在检查更新…" FontSize="12"
                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
            </Border>

            <ProgressBar x:Name="Bar" Height="4" Margin="0,10,0,0" Value="0" Maximum="100"
                         Background="Transparent" Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" Visibility="Collapsed" />

            <TextBlock x:Name="TxtNotes" Text="" FontSize="11.5" TextWrapping="Wrap"
                       Margin="0,10,0,0" Foreground="{StaticResource TextDim}" />

            <Grid Margin="0,14,0,0">
                <Button Content="关闭" Height="34" Width="88" HorizontalAlignment="Left"
                        Style="{StaticResource BtnGhost}" Click="Close_Click" />
                <Button x:Name="BtnCheck" Content="重新检查" Height="34" Width="104"
                        HorizontalAlignment="Right" Margin="0,0,112,0"
                        Style="{StaticResource BtnGhost}" Click="Check_Click" />
                <Button x:Name="BtnUpdate" Content="立即更新" Height="34" Width="104"
                        HorizontalAlignment="Right" Visibility="Collapsed"
                        Style="{StaticResource BtnPrimary}" Click="Update_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
