<Window x:Class="AiPai.Compact.Views.TransferOwnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="转让房主" Width="380" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        KeyDown="Win_KeyDown" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="12" Background="{StaticResource PanelBg}"
            BorderBrush="#FF33506F" BorderThickness="1">
        <StackPanel Margin="16,12,16,14">
            <Grid MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="转让房主" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnIcon}" Content="✕" HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>

            <TextBlock x:Name="TxtNet" Text="" FontSize="12.5" Margin="0,12,0,0"
                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />

            <Border Background="{StaticResource CardBg}" CornerRadius="9" Padding="11,9" Margin="0,10,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="转让后：" FontSize="11.5" Foreground="{StaticResource TextSecond}" />
                    <TextBlock Text="· 对方成为房主，可以删除组网、移出成员" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextDim}" />
                    <TextBlock Text="· 你自己变成普通成员，不能再删除该组网" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextDim}" />
                    <TextBlock Text="· 组网、适配码、已分配的固定 IP 都不变" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </Border>

            <TextBlock Text="转给哪个账号" FontSize="11.5" Margin="2,14,0,6"
                       Foreground="{StaticResource TextSecond}" />

            <Border Background="{StaticResource CardBg}" CornerRadius="9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="UserList" Margin="4" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="TxtMsg" Text="" FontSize="11" TextWrapping="Wrap" Margin="2,9,0,0" />

            <Grid Margin="0,14,0,0">
                <Button Content="取消" Height="36" Width="96" HorizontalAlignment="Left"
                        Style="{StaticResource BtnGhost}" Click="Close_Click" />
                <Button x:Name="BtnTransfer" Content="确认转让" Height="36" Width="120"
                        HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}"
                        Click="Transfer_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
