<UserControl x:Class="AiPai.Compact.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ① 状态条（压成一条） -->
        <Border Grid.Row="0" Margin="12,4,12,6" Padding="11,8" CornerRadius="10"
                Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource TextDim}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtState" Text="未连接" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtNet" Text="" FontSize="11.5" Margin="9,0,4,0"
                                   Foreground="{StaticResource TextSecond}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" x:Name="BadgeLink" Background="#2232D583" CornerRadius="7"
                                Padding="6,1" Margin="2,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtLink" Text="" FontSize="10"
                                       Foreground="{StaticResource OkBrush}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSpeed" Text="" FontSize="10.5" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                        <Button x:Name="BtnRefreshState" Content="⟳" Width="30" Height="28" FontSize="15"
                                Margin="0,0,6,0" Style="{StaticResource BtnGhost}"
                                Click="RefreshState_Click"
                                ToolTip="刷新组网列表和连接状态（已删除的组网会消失）" />
                        <Button x:Name="BtnLeave" Content="退出" Width="44" Height="28" FontSize="11.5"
                                Margin="0,0,6,0" Style="{StaticResource BtnGhost}" Click="Leave_Click"
                                ToolTip="退出该组网" />
                        <Button x:Name="BtnConnect" Content="连接" Width="54" Height="28" FontSize="12"
                                Style="{StaticResource BtnPrimary}" Click="Connect_Click" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtCode" Text="" FontSize="10.5" Cursor="Hand"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                               ToolTip="点击复制适配码" MouseLeftButtonUp="CopyCode_Click" />
                    <TextBlock Grid.Column="1" x:Name="TxtRight" Text="" FontSize="10.5"
                               HorizontalAlignment="Right" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="TxtHint" Text="" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{StaticResource WarnBrush}" Margin="0,5,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- ② 顶部小导航 -->
        <Grid Grid.Row="1" Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Tag="my" Click="Tab_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0">
                <StackPanel>
                    <TextBlock x:Name="TabMyText" Text="我的网络" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}" />
                    <Border x:Name="TabMyLine" Height="2" Width="30" CornerRadius="1" Margin="0,4,0,0"
                            Background="{StaticResource AccentBrush}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Tag="shared" Click="Tab_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0">
                <StackPanel>
                    <TextBlock x:Name="TabSharedText" Text="共享组网" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecond}" />
                    <Border x:Name="TabSharedLine" Height="2" Width="30" CornerRadius="1" Margin="0,4,0,0"
                            Background="Transparent" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Tag="create" Click="Tab_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0">
                <StackPanel>
                    <TextBlock x:Name="TabCreateText" Text="创建组网" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecond}" />
                    <Border x:Name="TabCreateLine" Height="2" Width="30" CornerRadius="1" Margin="0,4,0,0"
                            Background="Transparent" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ③ 内容区 -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="PaneMy" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListMy" Margin="12,2,12,10" />
            </ScrollViewer>

            <Grid x:Name="PaneShared" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 输入适配码加入别人的组网 -->
                <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="10"
                        Padding="11,9,11,9" Margin="12,2,12,8"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="加入别人的组网" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="TxtSharedCode" Style="{StaticResource Input}"
                                     FontFamily="Consolas" Margin="0,0,84,0"
                                     TextChanged="SharedCode_TextChanged"
                                     ToolTip="输入队友给你的 8 位适配码" />
                            <TextBlock x:Name="TxtSharedHint" Text="输入队友的适配码" FontSize="12"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" IsHitTestVisible="False" />
                            <Button x:Name="BtnSharedJoin" Content="加入组网" Width="78" Height="38"
                                    HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}"
                                    Click="JoinShared_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtSharedMsg" Text="" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Foreground="{StaticResource TextSecond}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListShared" Margin="12,0,12,10" />
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="PaneCreate" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="12,2,12,10">
                    <TextBlock Text="创建新组网" Style="{StaticResource TxtBody}" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtQuota" Text="" Style="{StaticResource TxtSub}"
                               TextWrapping="Wrap" Margin="0,4,0,2" />
                    <TextBlock Text="创建后生成适配码，队友输入同一个适配码即进入同一张局域网；加入别人的组网不受数量限制"
                               Style="{StaticResource TxtSub}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox x:Name="TxtNewName" Style="{StaticResource Input}" />
                    <Button x:Name="BtnCreate" Content="创建组网" Style="{StaticResource BtnPrimary}"
                            Margin="0,8,0,0" Click="Create_Click" />

                    <TextBlock x:Name="TxtCreateMsg" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
