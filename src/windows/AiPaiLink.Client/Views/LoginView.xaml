<UserControl x:Class="AiPai.Compact.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,12">

        <!-- 登录 -->
        <StackPanel x:Name="LoginPanel" VerticalAlignment="Top">
            <Image Source="pack://application:,,,/Assets/logo-mark.png" Width="76" Height="76"
                   Margin="0,16,0,0" />
            <TextBlock Text="艾派互联" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock Text="异地组网 · 远程互联" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecond}" Margin="0,6,0,0" />

            <TextBlock Text="账号" Style="{StaticResource TxtSub}" Margin="2,24,0,5" />
            <TextBox x:Name="TxtUser" Style="{StaticResource Input}" />

            <TextBlock Text="密码" Style="{StaticResource TxtSub}" Margin="2,12,0,5" />
            <PasswordBox x:Name="TxtPwd" Style="{StaticResource InputPassword}" />

            <Grid Margin="0,12,0,0">
                <CheckBox x:Name="ChkRemember" Content="记住密码" IsChecked="True" FontSize="12"
                          Foreground="{StaticResource TextSecond}" HorizontalAlignment="Left"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="LnkGoRegister" Text="注册账号" FontSize="12" Cursor="Hand"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" MouseLeftButtonUp="GoRegister_Click" />
            </Grid>

            <Button x:Name="BtnLogin" Content="登 录" Style="{StaticResource BtnPrimary}"
                    Margin="0,16,0,0" Click="Login_Click" />
            <TextBlock x:Name="TxtLoginMsg" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" Margin="2,10,0,0" />
        </StackPanel>

        <!-- 注册 -->
        <StackPanel x:Name="RegisterPanel" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock Text="注册账号" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,18,0,0" />
            <TextBlock Text="注册免费，不需要邀请码；客户端本身免费，会员按月收技术服务费" FontSize="11.5"
                       Foreground="{StaticResource TextSecond}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <TextBlock Text="账号" Style="{StaticResource TxtSub}" Margin="2,18,0,5" />
            <TextBox x:Name="RegUser" Style="{StaticResource Input}" />

            <TextBlock Text="密码" Style="{StaticResource TxtSub}" Margin="2,12,0,5" />
            <PasswordBox x:Name="RegPwd" Style="{StaticResource InputPassword}" />

            <TextBlock Text="邀请码（一般不填，我们发放时才需要）" Style="{StaticResource TxtSub}" Margin="2,12,0,5" />
            <TextBox x:Name="RegInvite" Style="{StaticResource Input}" ToolTip="注册免费，这里留空即可" />

            <TextBlock Text="邮箱（找回密码用，可留空）" Style="{StaticResource TxtSub}" Margin="2,12,0,5" />
            <TextBox x:Name="RegEmail" Style="{StaticResource Input}" />

            <Button x:Name="BtnRegister" Content="注 册" Style="{StaticResource BtnPrimary}"
                    Margin="0,18,0,0" Click="Register_Click" />
            <TextBlock x:Name="TxtRegMsg" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" Margin="2,10,0,0" />
            <TextBlock Text="返回登录" FontSize="12" Cursor="Hand" HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0"
                       MouseLeftButtonUp="GoLogin_Click" />
        </StackPanel>
    </Grid>
</UserControl>
